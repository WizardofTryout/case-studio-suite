# =====================================================================
# Case Studio Suite - Environment Configuration
# =====================================================================

# Gemini API Keys for Round-Robin Pool & Instant Failover (<50ms)
# Provide one or more comma-separated Gemini API keys
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Application Settings
HOST=0.0.0.0
PORT=8000
DATA_DIR=/app/data
DB_PATH=/app/data/case_studio.db
SKILLS_CATALOG_DIR=/app/skills_catalog

# Optional Default Models
DEFAULT_MODEL=gemini-2.5-pro
FALLBACK_MODEL=gemini-2.5-flash
