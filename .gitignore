# Environment & Secrets Protection (Never commit keys or credentials)
.env
.env.*
*.env
!/.env.example
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
*.token
credentials.md
secrets.json
secrets.yaml
id_rsa*
id_ed25519*


# SQLite and data folder
/data/case_studio.db
/data/case_studio.db-wal
/data/case_studio.db-shm
/data/.master_key
/data/projects/*
!/data/.gitkeep
!/data/projects/.gitkeep
/data/skills_catalog/*
!/data/skills_catalog/.gitkeep

